# LLM Configuration
LLM_PROVIDER=ollama # choices: ollama, anthropic, openai
LLM_MODEL=qwen2.5:7b # local model or cloud model name
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
OLLAMA_NUM_CTX=8192

# Execution Mode
OFFLINE_MODE=false # set to true when running in isolated sandbox without internet

# Cloud API Keys (if online mode is used)
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# API Service Configuration
PORT=8000
DEBUG=true

# LangSmith Monitoring (Highly recommended for online debugging)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=aawb-project

